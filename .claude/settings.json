{
  "permissions": {
    "allow": [
      "Bash(task:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)"
    ],
    "ask": [
      "Bash(gh pr merge)",
      "Bash(gh pr merge:*)",
      "Bash(git merge)",
      "Bash(git merge:*)",
      "Bash(git push origin main)",
      "Bash(git push origin main:*)",
      "Bash(git push -f:*)",
      "Bash(git push --force:*)"
    ],
    "additionalDirectories": [
      "../omator",
      "../ponderous-infra",
      "../ponderous-site",
      "../lawnomator-site",
      "../ponderous-hub",
      "../ponderous-docs"
    ]
  },
  "sandbox": {
    "filesystem": {
      "allowRead": [
        "../omator",
        "../ponderous-infra",
        "../ponderous-site",
        "../lawnomator-site",
        "../ponderous-hub",
        "../ponderous-docs"
      ]
    }
  }
}
